    {
        "id": "fnformatear",
        "type": "function",
        "z": "f1a0ctrlaltura",
        "name": "Formatear HEIGHT",
        "func": "// Arma el comando que espera el parser del STM32: \"HEIGHT:<n>\" + salto\nconst v = Math.round(Number(msg.payload));\n\n// El firmware ya hace clamp, pero validar aca evita mandar basura.\nif (!Number.isFinite(v) || v < 3 || v > 20) {\n    node.warn(\"Setpoint fuera de rango (3-20): \" + msg.payload);\n    return null;\n}\n\nmsg.payload = \"HEIGHT:\" + v + \"\\n\";\n\n// DOS SALIDAS:  1 -> CABLE      2 -> BLUETOOTH\n// El firmware escucha por los dos puertos, asi que para elegir el enlace\n// alcanza con DESCONECTAR el cable de la salida que no se quiera usar.\n// Si se dejan las dos conectadas, el comando sale por ambas y no pasa nada\n// malo: el STM32 recibe el mismo valor dos veces.\nreturn [msg, Object.assign({}, msg)];\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 160,
        "wires": [["serialoutcable", "dbgenviado"], ["serialoutbt"]]
    },
