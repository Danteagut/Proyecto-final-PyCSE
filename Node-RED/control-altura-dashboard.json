    {
        "id": "fnparsear",
        "type": "function",
        "z": "f1a0ctrlaltura",
        "name": "Parsear telemetria",
        "func": "// Telemetria del STM32:\n//   H:12.3,SP:15.0,V:62,VZ:-1.4,S:1,L:CABLE\n//\n//   H  = altura medida (cm)      VZ = velocidad vertical (cm/s)\n//   SP = setpoint vigente (cm)   S  = 1 si el sensor midio bien\n//   V  = empuje aplicado (%)     L  = enlace del ultimo comando\n\nconst linea = msg.payload.toString().trim();\nconst m = linea.match(/H:(-?[\\d.]+),SP:(-?[\\d.]+),V:(\\d+),VZ:(-?[\\d.]+),S:(\\d),L:(\\S*)/);\n\nif (!m) {\n    return null;   // linea incompleta o ruido: se descarta\n}\n\nconst t         = Date.now();\nconst altura    = parseFloat(m[1]);\nconst setpoint  = parseFloat(m[2]);\nconst empuje    = parseInt(m[3], 10);\nconst velocidad = parseFloat(m[4]);\nconst sensorOk  = m[5] === \"1\";\nconst enlace    = m[6];\n\n// El estado del nodo muestra por que enlace esta entrando la telemetria,\n// asi se ve de un vistazo si esta trabajando por cable o por Bluetooth.\nif (sensorOk) {\n    node.status({ fill: \"green\", shape: \"dot\",\n                  text: enlace + \" | \" + altura.toFixed(1) + \" cm\" });\n} else {\n    node.status({ fill: \"red\", shape: \"ring\", text: \"sensor sin eco\" });\n}\n\n// Dos series con la misma marca de tiempo, para que el escalon y la\n// respuesta queden alineados en el eje X.\nconst serieAltura   = { topic: \"Altura\",   payload: altura,   timestamp: t };\nconst serieSetpoint = { topic: \"Setpoint\", payload: setpoint, timestamp: t };\n\nreturn [\n    [serieAltura, serieSetpoint],\n    { payload: empuje },\n    { topic: \"Velocidad\", payload: velocidad, timestamp: t }\n];\n",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 390,
        "wires": [["chartescalon"], ["gaugeempuje"], ["chartvelocidad"]]
    },
